PORT=4000

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=iprn_sms_panel
PGUSER=postgres
PGPASSWORD=postgres

# ---------------------------------------------------------------------------
# Generic / shared-secret webhook
# ---------------------------------------------------------------------------
# Legacy generic endpoint (POST /api/webhook/receive)
WEBHOOK_TOKEN=change-this-secret

# ---------------------------------------------------------------------------
# Meta / WhatsApp / Facebook Messenger
# ---------------------------------------------------------------------------
# The "App Secret" from your Meta Developer App Dashboard
META_APP_SECRET=change-me-meta-app-secret
# The Verify Token you set in the Meta Webhooks configuration page
META_VERIFY_TOKEN=change-me-meta-verify-token

# ---------------------------------------------------------------------------
# Telegram Bot
# ---------------------------------------------------------------------------
# Secret token sent in X-Telegram-Bot-Api-Secret-Token header
# Set this when calling Telegram's setWebhook API
TELEGRAM_WEBHOOK_SECRET=change-me-telegram-secret
# Bot token (used to call Telegram API, stored for convenience)
TELEGRAM_BOT_TOKEN=change-me-telegram-bot-token

# ---------------------------------------------------------------------------
# Gmail / Google Pub/Sub
# ---------------------------------------------------------------------------
# The expected audience claim in the Pub/Sub push JWT
# Typically: https://pubsub.googleapis.com/projects/YOUR_PROJECT/topics/YOUR_TOPIC
GOOGLE_PUBSUB_AUDIENCE=change-me-google-pubsub-audience
# Optional: fallback shared secret for Pub/Sub push (if not using JWT)
GOOGLE_WEBHOOK_SECRET=change-me-google-secret
